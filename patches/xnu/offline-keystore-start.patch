diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1322,10 +1322,22 @@ bsd_autoconf(void)
 	kern_return_t result = IOKitBSDInit();
-#if (DEVELOPMENT || DEBUG) && defined(XNU_NATIVE_LEGACY_DISPLAY) && XNU_NATIVE_LEGACY_DISPLAY
-	/* The original IOSurface personality requires the genuine IOBSD resource.
-	 * The default-off framebuffer instrument may start only after publication.
-	 */
-	extern void native_legacy_display_late_probe(void);
-	native_legacy_display_late_probe();
-#endif
-	return result;
+#if (DEVELOPMENT || DEBUG) && defined(XNU_NATIVE_KEYSTORE) && XNU_NATIVE_KEYSTORE
+	/* m2381 no-SEP face (r102): nothing answers the unchanged libaks/MobileKeyBag
+	 * AppleKeyStore state queries, and launchd's AccessoryInteraction aborts pid 1
+	 * at the first MKBGetDeviceLockState failure (r101 32-frame stack, r94 same
+	 * wall). The device package KeyStoreProbe publication self-gates on its boot
+	 * args (offline-keystore/offline-key-events/aks) and stays inert
+	 * without them; XNU_NATIVE_KEYSTORE only wires this call in. The upstream
+	 * offline-legacy-start display probe keeps its own gate below, untouched.
+	 */
+	extern void native_keystore_probe(void);
+	native_keystore_probe();
+#endif
+#if (DEVELOPMENT || DEBUG) && defined(XNU_NATIVE_LEGACY_DISPLAY) && XNU_NATIVE_LEGACY_DISPLAY
+	/* The original IOSurface personality requires the genuine IOBSD resource.
+	 * The default-off framebuffer instrument may start only after publication.
+	 */
+	extern void native_legacy_display_late_probe(void);
+	native_legacy_display_late_probe();
+#endif
+	return result;
 }
