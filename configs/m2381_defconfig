# Kernel configuration of the m2381 image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# 2026-10-29 (ipados-26.5.2-23F84 arm64e lane): reshaped onto the proven sheng
# arm64e subset (their feat/ipados27-gpu-parity configs/sheng_ipados26_defconfig).
# The 21H461-lane constructs whose provider archives are 21H461-donor-pinned are
# OFF and return per-topic when re-derived for the 23F84 donor:
#   storage bindings (190-slot IOBlockStorageDevice pin + arm64e AUTH vtable
#   relocs), verified-root probe/stub (20H392/21H461 policies), VirtioMmioBlock
#   transport, mockfs fixture, native legacy display (no 23F84 ABI fixture
#   exists upstream; sheng's display lane is 24A446-only), ShengPlatformPower
#   (PMGR is prelinked from the 23F84 fileset roots).
# Root/storage authorization on this lane is the upstream source-storage model
# (CONFIG_XNU_SOURCE_STORAGE + a source storage archive) — not yet wired for
# m2381; the kernel itself builds and the fileset emitter runs.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
# 2026-10-29: off with the sheng arm64e shape — the NativeAES guard requires
# CRYPTO_BOOTSTRAP=prelinked, and this lane runs "source"; the SoftwareAES
# component (archive-05) provides the AES surface.
# CONFIG_XNU_NATIVE_AES is not set
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
# 2026-10-29: off with the archives above (21H461-donor providers).
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# CONFIG_XNU_SOURCE_MOCKFS is not set
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# OWNER_ROOT_AUDIT/TRUST stay ON (sheng_ipados26_defconfig parity): the
# owner-root kernel paths bind to the source-storage archive's
# SourceRootBinding.cpp queries, not to the dropped probe/stub archives.
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
# 2026-10-29 (ipados-26.5.2 lane): off — the 23F84 fileset prelinks the original
# com.apple.driver.ApplePMGR (profile roots), so the board-side ShengPlatformPower
# nub publisher is not built (its vtable audit + AON pins are 21H461-donor
# constants; phase 2 re-derives the charging stack). The soc patch's guarded
# call sites compile out with this unset.
# CONFIG_XNU_SHENG_PMGR is not set
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# The full BootProgress diagnostic (donor-agnostic; the telemetry providers the
# baseline cannot weak-resolve are linked as explicit zeros by
# build-boot-progress-telemetry.py — force_loaded below).
CONFIG_XNU_BOOT_PROGRESS=y
# n until the board-local GPU inputs exist: libAdreno740.a needs the
# ShengGmu*Source.h OPP/bandwidth policy (docs/porting/gpu.md; kept out of
# git upstream too) plus the .cache/firmware/sheng-gpu pinned blobs. Flip
# with the Adreno740 component/archive entries in one GPU topic.
CONFIG_XNU_NATIVE_ADRENO=n

# arm64e lane shape (sheng_ipados26/27_defconfig): corecrypto from source (the
# seal step in payload.py is arm64e-required) and chained fixups. The root
# authorization is the upstream source-storage model: on arm64e the ShengUfs
# component recipe IS build-sheng-source-storage.py (build-arm-driver.py
# routes it), whose archive embeds the verified-root-23F84 policy pair.
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
CONFIG_XNU_SOURCE_STORAGE=y
# The owner RAM Data seed volume UUID (built by the payload step, donor
# independent). The donor cryptex volume rides XNU_OWNER_CACHE_VOLUME_UUID.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
# The 23F84 donor cryptex SystemOS volume UUID (the window the owner cache
# mount unions over "/"; from the self-sufficient ipados-26.5.2-23F84 OS
# profile, systemos_volume_uuid). Without this line the kern_exec hook falls
# back to the in-tree patched value. The 20H392 value (96096B28…) retired
# with that frozen lane (git history, 2026-10-29).
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="7A23BAC7-E86D-4DF4-B181-E6D80F212AE5"
# The source-storage archive rides the NATIVE_UFS gate (build/sheng-ufs/
# libShengUfs.a is the same object set as libShengSourceStorage.a — forcing
# both duplicates every symbol, 2026-10-30). Only the telemetry zero-defs need
# the explicit force_load.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/boot-progress-telemetry/libBootProgressTelemetry.a"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
