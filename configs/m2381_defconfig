# Kernel configuration of the m2381 image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
# Schema v2 (2026-10-26): archive paths use the upstream component names
# (VirtioMmioBlock), the storage ABI comes from the static nx729j binding
# (build-storage-bindings.py → libStorageBindings.a, force-loaded below).
# 2026-10-27: NATIVE_LEGACY_DISPLAY=y — the display-analysis ABI audit is
# staged from the device repository pin and the display path runs through
# the UEFI GOP offline-legacy-* arguments (PLAN-display-lane.md).

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# The full BootProgress diagnostic: the kern_exec hook (XNU_OWNER_DATA_MOUNT
# path) calls sheng_boot_watchdog_policy — BootWatchdogPolicy.c, which writes
# launchd's disabled.plist so the unavailable watchdogd cannot panic the
# kernel. Without the flag the hook compiles out and watchdogd SIGTRAPs
# launchd into a kernel panic (observed on hardware 2026-10-26). This ld64
# errors on unresolved weak references (Apple's binds them to zero), so the
# diagnostic's telemetry providers are linked as explicit zeros from
# build-boot-progress-telemetry.py (force_loaded below) minus the
# legacy-display block, which the qualified lane provides for real.
CONFIG_XNU_BOOT_PROGRESS=y
# The display lane (2026-10-27, displayless 断言墙的机制解): the original
# IOMobileFramebufferLegacy ABI is bound by build-native-legacy-display.py
# (audit + 358-slot vtable + byte gates, same donor constants sheng runs),
# the CPU presentation publishes displayConfiguration from the UEFI GOP
# framebuffer, and SpringBoard's display-assert family stops firing. The
# displayless fixup war (r43-r50) has no upstream mechanism alternative:
# every SpringBoard-reaching board runs this lane.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
# n until the board-local GPU inputs exist: libAdreno740.a needs the
# ShengGmu*Source.h OPP/bandwidth policy (docs/porting/gpu.md; kept out of
# git upstream too) plus the .cache/firmware/sheng-gpu pinned blobs. Flip
# with the Adreno740 component/archive entries in one GPU topic.
CONFIG_XNU_NATIVE_ADRENO=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# The owner RAM Data seed volume UUID (built by the payload step, donor
# independent). The donor cryptex volume rides XNU_OWNER_CACHE_VOLUME_UUID.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
# The 23F84 donor cryptex SystemOS volume UUID (the window the owner cache
# mount unions over "/"; from the self-sufficient ipados-26.5.2-23F84 OS
# profile, systemos_volume_uuid). Without this line the kern_exec hook falls
# back to the in-tree patched value. The 20H392 value (96096B28…) retired
# with that frozen lane (git history, 2026-10-29).
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="7A23BAC7-E86D-4DF4-B181-E6D80F212AE5"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/virtio-mmio-block-verified-bundle/libVirtioMmioBlock.a"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
# The static storage ABI archive: absolute symbols for IOBlockStorageDevice's
# 190 dispatch slots, force-loaded next to the drivers that subclass it.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/io-storage-family/libStorageBindings.a -Wl,-force_load,{tree}/build/boot-progress-telemetry/libBootProgressTelemetry.a"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
